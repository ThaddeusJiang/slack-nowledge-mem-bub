# Slack Socket Mode
BUB_SLACK_BOT_TOKEN=xoxb-...
BUB_SLACK_APP_TOKEN=xapp-...

# Optional comma-separated Slack IDs. Applies to capture and Agent turns.
# BUB_SLACK_ALLOW_CHANNELS=C123,C456
# BUB_SLACK_ALLOW_USERS=U123,U456

# Nowledge Mem (local defaults to http://127.0.0.1:14242)
# NMEM_API_URL=https://your-nowledge-mem-server
# NMEM_API_KEY=...
NMEM_SESSION_CONTEXT=0
# bub-slack captures both user and assistant messages in the Slack thread.
NMEM_SESSION_DIGEST=0

# Configure the model provider used by Bub.
# OPENAI_API_KEY=...
